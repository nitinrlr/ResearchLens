// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  COMPLETED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  image           String?
  experienceLevel ExperienceLevel  @default(BEGINNER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  goals           Goal[]
  collections     Collection[]
  readingHistory  ReadingHistory[]
}

model Paper {
  id               String            @id @default(uuid())
  title            String
  abstract         String
  publishedDate    DateTime
  difficulty       Int
  readingTime      Int
  paperUrl         String            @unique
  pdfUrl           String?
  thumbnailUrl     String?
  externalId       String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  paperTopics      PaperTopic[]
  collectionPapers CollectionPaper[]
  readingHistory   ReadingHistory[]
  paperAuthors     PaperAuthor[]
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalTopics GoalTopic[]
}

model Topic {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  goalTopics  GoalTopic[]
  paperTopics PaperTopic[]
}

model GoalTopic {
  goalId  String
  topicId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([goalId, topicId])
}

model PaperTopic {
  paperId String
  topicId String

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([paperId, topicId])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  /// Every user gets exactly one default collection ("Saved") at sign-up.
  /// It is the target of the bookmark button and cannot be deleted.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionPapers CollectionPaper[]

  @@index([userId])
}

model CollectionPaper {
  collectionId String
  paperId      String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  paper      Paper      @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@id([collectionId, paperId])
}

/// One row per paper a user has opened. Created automatically the first time
/// they view a paper, and bumped on every later visit so "Continue Reading"
/// can list papers most-recently-opened first.
model ReadingHistory {
  userId        String
  paperId       String
  firstReadAt   DateTime      @default(now())
  lastReadAt    DateTime      @default(now())
  readingStatus ReadingStatus @default(READING)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@id([userId, paperId])
  @@index([userId, lastReadAt])
}

model Author {
  id          String  @id @default(uuid())
  openAlexId  String  @unique
  name        String
  institution String?

  paperAuthors PaperAuthor[]
}

model PaperAuthor {
  paperId     String
  authorId    String
  authorOrder Int

  paper  Paper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([paperId, authorId])
}
